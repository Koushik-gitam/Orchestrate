# Free API Configuration
# These are public/demo keys - no authentication required for basic usage

PORT=3000
NODE_ENV=development

# Exchange Rate API (free tier - no key required)
EXCHANGE_RATE_API=https://api.exchangerate-api.com/v4/latest/

# For production, you can add your own free API keys below:
# CURRENCY_API_KEY=your_key_here
# EXCHANGE_RATE_KEY=your_key_here

# Demo users can use the built-in fallback rates
USE_FALLBACK_RATES=true
